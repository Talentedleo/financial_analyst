# ===========================================
# Financial Analyst AI Agent - Environment Config
# ===========================================
# Copy this file to .env and fill in your API keys

# ============ Required APIs ============

# MiniMax API Key (get from https://platform.minimaxi.com/)
MINIMAX_API_KEY=your-minimax-api-key-here

# MiniMax API Base (国内版使用此地址)
MINIMAX_API_BASE=https://api.minimax.chat/v1

# DeepSeek API Key (get from https://platform.deepseek.com/)
# Used as fallback when MiniMax is not configured
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DeepSeek API Base
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Finnhub API Key (get from https://finnhub.io/)
FINNHUB_API_KEY=your-finnhub-api-key-here

# ============ Optional APIs ============

# Bark Push Notification (iOS)
# Get your push key from the Bark iOS app
BARK_DEVICE_KEY=your-bark-push-key-here
BARK_SERVER_URL=https://api.day.app

# ============ Server Config ============

# API Authentication (change in production!)
API_MASTER_KEY=sk-1234

# CORS (comma-separated origins, for production)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
